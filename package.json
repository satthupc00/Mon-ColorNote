{
  "name": "mon-trinote",
  "productName": "Mon TriNote",
  "version": "0.2.0",
  "description": "Ghi chú 3 màu, đồng bộ PC và điện thoại",
  "author": "Mondiro",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never",
    "android:sync": "vite build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.9",
    "@capgo/capacitor-native-biometric": "7.6.0",
    "@fontsource/baloo-2": "5.2.6",
    "@fontsource/nunito": "5.2.6",
    "electron-updater": "6.6.2",
    "firebase": "11.10.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "electron": "38.8.6",
    "electron-builder": "26.0.12",
    "vite": "6.4.4"
  },
  "build": {
    "appId": "com.mondiro.trinote",
    "productName": "Mon TriNote",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Mon-TriNote-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Mon TriNote"
    },
    "publish": {
      "provider": "github",
      "owner": "satthupc00",
      "repo": "Mon-ColorNote",
      "releaseType": "release"
    },
    "asarUnpack": [
      "electron/hello.ps1"
    ]
  }
}
